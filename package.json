{
  "name": "@worldclasscitizen/ralph",
  "version": "0.3.0",
  "description": "Graph-native local agent orchestration with isolated Ralph loops",
  "type": "module",
  "bin": {
    "ralph": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "integrations",
    "docs",
    "START_HERE.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:runtime && npm run build:ui",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-install.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build",
    "build:runtime": "tsc -p tsconfig.json",
    "build:ui": "tsc -p ui/tsconfig.json && vite build ui --config ui/vite.config.ts",
    "test:e2e": "node scripts/test-ui.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:core": "node scripts/check-release.mjs --local",
    "release": "node scripts/release.mjs",
    "test:operational": "node scripts/test-operational.mjs",
    "test:live:release": "node scripts/live-functional.mjs",
    "test:live:comparison": "node scripts/live-release.mjs",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "support:sync": "node scripts/sync-provider-support.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "6.4.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldclasscitizen/Ralph.git"
  }
}
